{
  "name": "healthmind360",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test",
    "test:perf": "playwright test --project=perf --workers=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:test:init": "docker compose exec -T db sh /docker-entrypoint-initdb.d/02-test-db.sh",
    "db:operator:init": "docker compose exec -T db sh /docker-entrypoint-initdb.d/03-operator-role.sh",
    "db:worker:init": "docker compose exec -T db sh /docker-entrypoint-initdb.d/04-worker-role.sh",
    "db:backup:init": "docker compose exec -T db sh /docker-entrypoint-initdb.d/05-backup-role.sh",
    "privacy:requests": "node scripts/privacy-requests.mjs",
    "mail:up": "docker compose up -d mailpit",
    "db:verify-roles": "node scripts/verify-db-roles.mjs",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "audit": "pnpm audit --audit-level=high",
    "test:db": "vitest run --project db",
    "db:deploy": "prisma migrate deploy",
    "db:resync-migration": "node scripts/resync-migration.mjs",
    "db:seed": "node --import ./scripts/ts-loader.mjs scripts/seed-demo.ts",
    "check:retention": "node --import ./scripts/ts-loader.mjs scripts/check-retention.ts",
    "check:perf-budget": "node scripts/check-perf-budget.mjs",
    "check:infra": "node --import ./scripts/ts-loader.mjs scripts/check-infra.ts",
    "backup:create": "node --import ./scripts/ts-loader.mjs scripts/backup.ts create",
    "backup:ledger": "node --import ./scripts/ts-loader.mjs scripts/backup.ts ledger",
    "backup:restore": "node --import ./scripts/ts-loader.mjs scripts/backup.ts restore",
    "backup:reapply": "node --import ./scripts/ts-loader.mjs scripts/backup.ts reapply",
    "backup:drop": "node --import ./scripts/ts-loader.mjs scripts/backup.ts drop"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-three/fiber": "9.8.1",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "gltfpack": "1.2.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}

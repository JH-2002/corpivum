# Copie para .env e ajuste. NUNCA commite o .env (CLAUDE.md regra 6).
# Valores abaixo são placeholders de DESENVOLVIMENTO LOCAL; em produção use o gerenciador de segredos.

# --- Ambiente -------------------------------------------------------------------------------
APP_ENV=development
# Região de execução/dados. Tudo deve rodar no Brasil (LEG-S10). Ex.: gru1 (Vercel), sa-east-1 (AWS).
APP_REGION=gru1
# Desliga a telemetria anônima do Next.js (sem envio de metadados de build para terceiros).
NEXT_TELEMETRY_DISABLED=1
# Desliga a telemetria da CLI do Prisma (checkpoint.prisma.io).
CHECKPOINT_DISABLE=1

# --- Banco local (docker-compose) -----------------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=troque-localmente
POSTGRES_PORT=5432
APP_DB_NAME=healthmind
APP_MIGRATOR_PASSWORD=troque-localmente
APP_USER_PASSWORD=troque-localmente

# Runtime: papel app_user (sem BYPASSRLS, não é dono das tabelas) — LEG-S03
DATABASE_URL=postgresql://app_user:troque-localmente@localhost:5432/healthmind
# Migrações (Prisma CLI): papel app_migrator, dono das tabelas — LEG-S03
MIGRATION_DATABASE_URL=postgresql://app_migrator:troque-localmente@localhost:5432/healthmind

# --- Autenticação (ADR-0014) -----------------------------------------------------------------
# Base dos links de e-mail. Em produção, https obrigatório.
APP_URL=http://localhost:3000
# Segredos de 32 bytes em base64, DIFERENTES entre si. Gere cada um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
RATE_LIMIT_SECRET=
# Cabeçalho com o IP do cliente escrito pela hospedagem (obrigatório em produção). Vazio em dev: usa o
# último salto de X-Forwarded-For. Só vira chave HMAC de limite de tentativas; nunca é gravado.
# CLIENT_IP_HEADER=x-real-ip

# --- Retenção (LEG-D04, LEG-R02, LEG-S07) ---------------------------------------------------
# Purga definitiva após exclusão de conta, em dias.
PURGE_DAYS=30
# Registros de acesso (Marco Civil art. 15, se aplicável — ver LEG-R02 / OPEN_ISSUES).
ACCESS_LOG_RETENTION_DAYS=180
# Retenção de backups. Precisa ser <= PURGE_DAYS; a validação de env falha se não for.
BACKUP_RETENTION_DAYS=30
# Prazo entre revogar o consentimento de dados de saúde e eliminá-los (ADR-0019). LEGAL-REVIEW (OI-04).
# Está escrito no texto do consentimento (catálogo HEALTH_DATA_GRACE_DAYS_IN_TEXT): mudar exige nova versão.
HEALTH_DATA_GRACE_DAYS=30
# Retenção das provas de consentimento e de pedidos do titular (LEG-R03). LEGAL-REVIEW (OI-04).
PROOF_RETENTION_DAYS=1825

# --- Adaptadores ----------------------------------------------------------------------------
# Implementações locais/fake. Em APP_ENV=production, fake/local/console/memory são recusados.
LLM_PROVIDER=fake
KMS_PROVIDER=local
# Chave mestra de DEV (32 bytes em base64). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KMS_LOCAL_MASTER_KEY=
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.storage
MAIL_PROVIDER=console
# Com APP_ENV=development, o provedor console entrega ao Mailpit local (pnpm mail:up; interface em
# http://localhost:8025). Só host local é aceito. Testes e produção não usam estas variáveis.
DEV_SMTP_HOST=localhost
DEV_SMTP_PORT=1025
# Fila de jobs: memory (dev/test) ou postgres (exigido em produção; ADR-0019, OI-14).
JOB_QUEUE=memory
# inline: esta instância também executa os jobs. off: só enfileira (worker em processo separado).
JOB_WORKER=inline
AGE_SIGNAL_PROVIDER=none
# Integrações com wearables exigem nova finalidade, consentimento e revisão do RIPD (LEG-X04).
WEARABLE_PROVIDER=disabled

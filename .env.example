# Copie para .env e ajuste. NUNCA commite o .env (CLAUDE.md regra 6).
# Valores abaixo são placeholders de DESENVOLVIMENTO LOCAL; em produção use o gerenciador de segredos.

# --- Ambiente -------------------------------------------------------------------------------
APP_ENV=development
# Região de execução/dados. Tudo deve rodar no Brasil (LEG-S10). Ex.: gru1 (Vercel), sa-east-1 (AWS).
APP_REGION=gru1
# Desliga a telemetria anônima do Next.js (sem envio de metadados de build para terceiros).
NEXT_TELEMETRY_DISABLED=1
# Desliga a telemetria da CLI do Prisma (checkpoint.prisma.io).
CHECKPOINT_DISABLE=1

# --- Banco local (docker-compose) -----------------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=troque-localmente
POSTGRES_PORT=5432
APP_DB_NAME=healthmind
APP_MIGRATOR_PASSWORD=troque-localmente
APP_USER_PASSWORD=troque-localmente
APP_OPERATOR_PASSWORD=troque-localmente
APP_WORKER_PASSWORD=troque-localmente
APP_BACKUP_PASSWORD=troque-localmente

# Runtime: papel app_user (sem BYPASSRLS, não é dono das tabelas) — LEG-S03
DATABASE_URL=postgresql://app_user:troque-localmente@localhost:5432/healthmind
# Migrações (Prisma CLI): papel app_migrator, dono das tabelas — LEG-S03
MIGRATION_DATABASE_URL=postgresql://app_migrator:troque-localmente@localhost:5432/healthmind
# Jobs em segundo plano (ADR-0037): papel app_worker, o único que executa as varreduras e expurgos. Obrigatório
# onde a fila é consumida (fila em memória ou JOB_WORKER=inline); instâncias web com JOB_WORKER=off não usam.
WORKER_DATABASE_URL=postgresql://app_worker:troque-localmente@localhost:5432/healthmind
# Atendimento manual de pedidos do titular (`pnpm privacy:requests`, ADR-0034/0037): papel de login de UMA
# pessoa (operador_dev em dev), membro do grupo app_operator, que só executa as funções app.operator_*. Só para
# o script de linha de comando; o runtime web recusa em produção.
OPERATOR_DATABASE_URL=postgresql://operador_dev:troque-localmente@localhost:5432/healthmind
# Livro de reaplicação dos backups (`pnpm backup:ledger` e `backup:restore --source`, ADR-0040): papel app_backup,
# que só executa app.restore_ledger. Nunca no runtime.
BACKUP_DATABASE_URL=postgresql://app_backup:troque-localmente@localhost:5432/healthmind

# Banco SÓ PARA TESTES (ADR-0024): `pnpm test:db` e o e2e apagam tabelas e usam apenas estas URLs.
# O nome precisa terminar em _test; os testes recusam rodar no banco de desenvolvimento.
APP_TEST_DB_NAME=healthmind_test
TEST_DATABASE_URL=postgresql://app_user:troque-localmente@localhost:5432/healthmind_test
TEST_MIGRATION_DATABASE_URL=postgresql://app_migrator:troque-localmente@localhost:5432/healthmind_test
TEST_WORKER_DATABASE_URL=postgresql://app_worker:troque-localmente@localhost:5432/healthmind_test
TEST_OPERATOR_DATABASE_URL=postgresql://operador_dev:troque-localmente@localhost:5432/healthmind_test
TEST_BACKUP_DATABASE_URL=postgresql://app_backup:troque-localmente@localhost:5432/healthmind_test

# --- Autenticação (ADR-0014) -----------------------------------------------------------------
# Base dos links de e-mail. Em produção, https obrigatório.
APP_URL=http://localhost:3000
# Segredos de 32 bytes em base64, DIFERENTES entre si. Gere cada um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
RATE_LIMIT_SECRET=
# Pepper dos códigos de recuperação do MFA (ADR-0037): girá-lo invalida os códigos; os outros dois, não.
RECOVERY_CODE_PEPPER=
# Cabeçalho com o IP do cliente escrito pela hospedagem (obrigatório em produção). Vazio em dev: usa o
# último salto de X-Forwarded-For. Só vira chave HMAC de limite de tentativas; nunca é gravado.
# x-forwarded-for não é aceito aqui: o 1º valor vem do cliente (PR1a-R2-B3).
# CLIENT_IP_HEADER=x-real-ip

# --- Retenção (LEG-D04, LEG-R02, LEG-S07) ---------------------------------------------------
# Purga definitiva após exclusão de conta, em dias.
PURGE_DAYS=30
# Registros de acesso (Marco Civil art. 15, se aplicável — ver LEG-R02 / OPEN_ISSUES).
ACCESS_LOG_RETENTION_DAYS=180
# Retenção de backups. Precisa ser <= PURGE_DAYS; a validação de env falha se não for.
BACKUP_RETENTION_DAYS=30
# Chave dos arquivos de backup e dos livros de reaplicação (`pnpm backup:*`, ADR-0040): 32 bytes em base64,
# diferente de todos os outros segredos. Perdê-la torna os backups ilegíveis: guardar no gerenciador de segredos,
# fora do banco e fora do provedor dos backups. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=
# Prazo entre revogar o consentimento de dados de saúde e eliminá-los (ADR-0019). LEGAL-REVIEW (OI-04).
# Está escrito no texto do consentimento (catálogo HEALTH_DATA_GRACE_DAYS_IN_TEXT): mudar exige nova versão.
HEALTH_DATA_GRACE_DAYS=30
# Retenção das provas de consentimento e de pedidos do titular (LEG-R03). LEGAL-REVIEW (OI-04).
PROOF_RETENTION_DAYS=1825
# Validade do link de download de exportações e relatórios, em horas (LEG-D03): de 1 a 24.
EXPORT_LINK_HOURS=24

# --- Adaptadores ----------------------------------------------------------------------------
# Implementações locais/fake. Em APP_ENV=production, fake/local/console/memory são recusados
# (exceto ERROR_REPORTER=console, que só grava o relatório filtrado no log).
KMS_PROVIDER=local
# Chave mestra de DEV (32 bytes em base64). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KMS_LOCAL_MASTER_KEY=
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.storage
MAIL_PROVIDER=console
# Com APP_ENV=development, o provedor console entrega ao Mailpit local (pnpm mail:up; interface em
# http://localhost:8025). Só host local é aceito. Testes e produção não usam estas variáveis.
DEV_SMTP_HOST=localhost
DEV_SMTP_PORT=1025
# Fila de jobs: memory (dev/test) ou postgres (exigido em produção; ADR-0019, OI-14).
JOB_QUEUE=memory
# inline: esta instância também executa os jobs. off: só enfileira (worker em processo separado).
JOB_WORKER=inline
AGE_SIGNAL_PROVIDER=none
# Integrações com wearables exigem nova finalidade, consentimento e revisão do RIPD (LEG-X04).
WEARABLE_PROVIDER=disabled
# Ferramenta de erros (ADR-0038): console grava no log só o relatório filtrado por lista de campos
# (sem mensagem, corpo, query, cabeçalhos ou cookies). memory é só para testes.
ERROR_REPORTER=console

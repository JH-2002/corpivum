// Fase 1a: conta, sessões em banco, MFA, tokens e limites de tentativa (LEG-S03, LEG-S04).
// Fase 1b: consentimento, versões de política, provas, AuditLog/AccessLog e fila de jobs (ADR-0019).
// Fase 2: dados de saúde (sono, humor, hábitos, diário, corpo) com RLS por dono E consentimento (ADR-0021).
// As políticas RLS e as funções SECURITY DEFINER ficam no SQL das migrações (ADR-0015).
//
// REGRA (PR1a-R3-B8, LEG-R03): tabelas de PROVA (consent_records, policy_acceptances, privacy_requests,
// audit_logs) e access_logs guardam `user_id` SEM FK para users. O expurgo de contas não as apaga em
// cascata nem é bloqueado por elas. Só tabelas de auth e de dados do próprio usuário usam FK com CASCADE
// (testes em tests/db/privacy.test.ts e tests/db/health-coverage.test.ts).
// A URL de conexão fica em prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Conta. Dados não sensíveis (base: execução de contrato). Para 18+ guarda só a declaração (LEG-F01).
model User {
  id                    String    @id @default(uuid(7)) @db.Uuid
  /// Normalizado (trim + minúsculas) pela aplicação.
  email                 String    @unique
  emailVerifiedAt       DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// Argon2id em formato PHC.
  passwordHash          String    @map("password_hash")
  adultAttestedAt       DateTime  @map("adult_attested_at") @db.Timestamptz(3)
  ageGateVersion        String    @map("age_gate_version")
  mfaEnabledAt          DateTime? @map("mfa_enabled_at") @db.Timestamptz(3)
  /// Segredo TOTP cifrado (envelope ADR-0016, contexto users.totp_secret).
  totpSecret            Bytes?    @map("totp_secret")
  /// Último passo TOTP aceito: códigos de passo <= este são recusados (anti-reuso).
  totpLastUsedStep      BigInt?   @map("totp_last_used_step")
  /// Início da ativação do TOTP (segredo pendente). Pendente vence em 15 min e é apagado em 1 dia.
  totpSetupStartedAt    DateTime? @map("totp_setup_started_at") @db.Timestamptz(3)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(3)
  /// Fim do onboarding (§52): termos aceitos e escolhas de consentimento feitas.
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(3)
  /// Eliminação agendada dos dados de saúde após revogar o consentimento (ADR-0019). NULL = nada agendado.
  healthDataPurgeAt     DateTime? @map("health_data_purge_at") @db.Timestamptz(3)
  /// Escolha do passo 5 do onboarding (§52.5). NULL = ainda não escolheu. `demo` = dados fictícios gerados
  /// em memória, nada gravado nas tabelas de saúde (ADR-0021).
  dataMode              DataMode? @map("data_mode")
  /// Sequências (streaks) de hábitos visíveis. Desativável (LEG-F05).
  streaksEnabled        Boolean   @default(true) @map("streaks_enabled")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions      Session[]
  recoveryCodes RecoveryCode[]
  authTokens    AuthToken[]
  reauthProofs  ReauthProof[]

  sleepEntries     SleepEntry[]
  moodEntries      MoodEntry[]
  habits           Habit[]
  habitChecks      HabitCheck[]
  journalEntries   JournalEntry[]
  bodyMeasurements BodyMeasurement[]

  @@map("users")
}

/// Sessão em banco, listável e revogável (LEG-S04). Só o hash do token é guardado.
model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     Bytes     @unique @map("token_hash")
  /// Rótulo grosso do dispositivo (ex.: "Chrome · Windows"). Sem IP.
  deviceLabel   String    @map("device_label")
  mfaPending    Boolean   @default(false) @map("mfa_pending")
  /// Tentativas de TOTP/recuperação nesta sessão pendente.
  mfaAttempts   Int       @default(0) @map("mfa_attempts")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Código de recuperação do MFA, de uso único. Só HMAC-SHA-256 (LEG-S04).
model RecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  Bytes     @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

enum AuthTokenPurpose {
  verify_email
  reset_password

  @@map("auth_token_purpose")
}

/// Token de uso único (verificação de e-mail, redefinição de senha). Só o hash. Sem DML direto do runtime.
model AuthToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash Bytes            @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// Janela fixa de limite de tentativas. Chave = HMAC (IP/e-mail nunca em claro). Sem DML direto do runtime.
model RateLimitBucket {
  keyHash     Bytes    @map("key_hash")
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int      @default(0)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([keyHash, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

// ---------------------------------------------------------------------------------------------------
// Fase 1b: consentimento e provas (LEG-C01–C06, LEG-R03, LEG-S06, LEG-R02). Ver ADR-0019.
// ---------------------------------------------------------------------------------------------------

/// Finalidades de consentimento (LEG-C02). Cada uma com texto e versão próprios.
enum ConsentPurpose {
  health_data
  ai_sharing
  international_transfer
  marketing
  product_metrics

  @@map("consent_purpose")
}

/// Documentos versionados (LEG-G04, LEG-C06).
enum PolicyDocument {
  privacy_policy
  terms
  consent_health_data
  consent_ai_sharing
  consent_international_transfer
  consent_marketing
  consent_product_metrics

  @@map("policy_document")
}

/// Versão publicada de um documento. `text_hash` = SHA-256 do texto exato exibido. Sem DML do runtime.
model PolicyVersion {
  id                String         @id @default(uuid(7)) @db.Uuid
  document          PolicyDocument
  version           Int
  textHash          String         @map("text_hash")
  /// Mudança substancial: exige reconsentimento ou novo aceite antes de continuar (LEG-C06).
  requiresReconsent Boolean        @map("requires_reconsent")
  publishedAt       DateTime       @map("published_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  consentRecords    ConsentRecord[]
  policyAcceptances PolicyAcceptance[]

  @@unique([document, version])
  @@map("policy_versions")
}

/// Consentimento por finalidade (LEG-C01). Conceder de novo cria outro registro; revogar só preenche
/// `revoked_at`. Prova (LEG-R03): sem FK para users.
model ConsentRecord {
  id              String         @id @default(uuid(7)) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  purpose         ConsentPurpose
  policyVersionId String         @map("policy_version_id") @db.Uuid
  textHash        String         @map("text_hash")
  grantedAt       DateTime       @map("granted_at") @db.Timestamptz(3)
  revokedAt       DateTime?      @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  policyVersion PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@index([userId, purpose])
  @@map("consent_records")
}

/// Aceite dos Termos e ciência da Política (base: contrato, não consentimento). Prova sem FK para users.
model PolicyAcceptance {
  id              String   @id @default(uuid(7)) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  policyVersionId String   @map("policy_version_id") @db.Uuid
  acceptedAt      DateTime @map("accepted_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  policyVersion PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("policy_acceptances")
}

enum PrivacyRequestKind {
  confirmation_access
  correction
  portability
  deletion
  anonymization
  sharing_info
  automated_review
  minor_closure

  @@map("privacy_request_kind")
}

enum PrivacyRequestStatus {
  open
  in_progress
  completed
  rejected

  @@map("privacy_request_status")
}

/// Pedido do titular (LEG-D07). Prova com dados mínimos, sem FK para users (LEG-R03).
model PrivacyRequest {
  id           String               @id @default(uuid(7)) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  kind         PrivacyRequestKind
  status       PrivacyRequestStatus
  /// Declaração completa em até 15 dias (art. 19, II).
  dueAt        DateTime             @map("due_at") @db.Timestamptz(3)
  closedAt     DateTime?            @map("closed_at") @db.Timestamptz(3)
  /// Só em `automated_review` (LEG-D08): versão do Índice e período revisados. Nunca valores de saúde.
  scoreVersion Int?                 @map("score_version") @db.SmallInt
  periodStart  DateTime?            @map("period_start") @db.Date
  periodEnd    DateTime?            @map("period_end") @db.Date
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("privacy_requests")
}

enum AuditAction {
  onboarding_completed
  policy_accepted
  consent_granted
  consent_revoked
  health_data_elimination_scheduled
  health_data_elimination_cancelled
  health_data_eliminated
  session_revoked
  privacy_request_created
  account_closed_minor

  @@map("audit_action")
}

enum AuditResourceType {
  user
  consent_record
  policy_version
  privacy_request
  session
  health_data

  @@map("audit_resource_type")
}

/// Trilha de auditoria (LEG-S06): quem, quando, o quê. SEM conteúdo (sem texto livre nem JSON).
/// Escrita só por `app.audit_append`; o runtime não lê, não altera e não apaga.
model AuditLog {
  id            String            @id @default(uuid(7)) @db.Uuid
  actorUserId   String?           @map("actor_user_id") @db.Uuid
  subjectUserId String?           @map("subject_user_id") @db.Uuid
  action        AuditAction
  resourceType  AuditResourceType @map("resource_type")
  resourceId    String?           @map("resource_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([subjectUserId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Registro de acesso à aplicação (Marco Civil art. 15, LEG-R02): IP e data/hora. Tabela separada,
/// expurgada após ACCESS_LOG_RETENTION_DAYS. Escrita só por `app.access_log_append`; o runtime não lê.
model AccessLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  ip         String?  @db.Inet
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([occurredAt])
  @@index([userId, occurredAt])
  @@map("access_logs")
}

/// Prova de reautenticação (senha conferida há pouco), de uso único e 2 min de validade, exigida por
/// ações destrutivas como o encerramento de conta (ADR-0019). Só o hash do nonce. Sem DML do runtime.
model ReauthProof {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  purpose   String
  tokenHash Bytes     @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reauth_proofs")
}

enum JobStatus {
  queued
  running
  failed

  @@map("job_status")
}

/// Fila de jobs no Postgres (OI-14, ADR-0019). Payload só com primitivos (IDs), nunca conteúdo.
/// Acesso só pelas funções `app.jobs_*`. Jobs concluídos são apagados.
model Job {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          String
  payload       Json
  runAt         DateTime  @map("run_at") @db.Timestamptz(3)
  status        JobStatus @default(queued)
  attempts      Int       @default(0)
  maxAttempts   Int       @map("max_attempts")
  /// Com valor, no máximo um job `queued` por chave (resolve PR1a-R2-B6).
  singletonKey  String?   @map("singleton_key")
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(3)
  lockedBy      String?   @map("locked_by")
  lastErrorCode String?   @map("last_error_code")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, runAt])
  @@map("job_queue")
}

// ---------------------------------------------------------------------------------------------------
// Fase 2: dados de saúde (ADR-0021). Base: consentimento `health_data` (LEG-C02).
// REGRAS: user_id com FK CASCADE; RLS SELECT/INSERT/UPDATE exigem dono E app.has_active_consent('health_data');
// DELETE só por dono (eliminação após revogação). Texto livre cifrado (`*_enc`, ADR-0016, LEG-S02), nunca
// pesquisável. Eliminador registrado em src/server-health-erasers.ts (teste: tests/db/health-coverage.test.ts).
// ---------------------------------------------------------------------------------------------------

enum DataMode {
  demo
  own

  @@map("data_mode")
}

/// Sono informado (§20). Duração e regularidade são calculadas na leitura.
model SleepEntry {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  bedAt      DateTime @map("bed_at") @db.Timestamptz(3)
  wakeAt     DateTime @map("wake_at") @db.Timestamptz(3)
  /// 1–5, autorrelato.
  quality    Int?     @db.SmallInt
  awakenings Int?     @db.SmallInt
  /// Nota livre cifrada (contexto sleep_entries.note_enc).
  noteEnc    Bytes?   @map("note_enc")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, wakeAt])
  @@map("sleep_entries")
}

/// Etiquetas fixas de emoção (§21). Lista fechada, sem texto livre.
enum MoodEmotion {
  calm
  joy
  gratitude
  motivation
  focus
  tiredness
  worry
  irritation
  sadness
  boredom

  @@map("mood_emotion")
}

/// Humor, energia e estresse autorrelatados, 1–5 (§21).
model MoodEntry {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  loggedAt  DateTime      @map("logged_at") @db.Timestamptz(3)
  mood      Int           @db.SmallInt
  energy    Int           @db.SmallInt
  stress    Int           @db.SmallInt
  emotions  MoodEmotion[]
  /// Nota livre cifrada (contexto mood_entries.note_enc).
  noteEnc   Bytes?        @map("note_enc")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@map("mood_entries")
}

enum HabitFrequency {
  daily
  weekdays
  times_per_week

  @@map("habit_frequency")
}

/// Hábito (§22). O nome pode revelar dado de saúde: cifrado (contexto habits.name_enc).
model Habit {
  id           String         @id @default(uuid(7)) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  nameEnc      Bytes          @map("name_enc")
  frequency    HabitFrequency
  /// Dias da semana (0 = domingo) quando `weekdays`.
  weekdays     Int[]          @db.SmallInt
  /// Vezes por semana quando `times_per_week`.
  timesPerWeek Int?           @map("times_per_week") @db.SmallInt
  archivedAt   DateTime?      @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  checks HabitCheck[]

  @@unique([id, userId])
  @@index([userId])
  @@map("habits")
}

/// Check diário de um hábito. FK composta (habit_id, user_id): o check é sempre do dono do hábito.
model HabitCheck {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  habitId   String   @map("habit_id") @db.Uuid
  day       DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([habitId, day])
  @@index([userId, day])
  @@map("habit_checks")
}

/// Etiquetas fixas e não sensíveis do diário (filtro permitido, SPEC_ADDENDUM §19).
enum JournalTag {
  work
  study
  family
  friends
  rest
  movement
  leisure
  nature
  routine
  other

  @@map("journal_tag")
}

/// Diário (§19). Conteúdo cifrado (contexto journal_entries.content_enc), SEM busca textual (LEG-S02).
model JournalEntry {
  id         String       @id @default(uuid(7)) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  entryDate  DateTime     @map("entry_date") @db.Date
  contentEnc Bytes        @map("content_enc")
  mood       Int?         @db.SmallInt
  tags       JournalTag[]
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entryDate])
  @@map("journal_entries")
}

/// Peso e medidas informados (§23). IMC é calculado na leitura (ESTIMADO).
model BodyMeasurement {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  measuredAt DateTime @map("measured_at") @db.Timestamptz(3)
  weightKg   Float?   @map("weight_kg")
  heightCm   Float?   @map("height_cm")
  waistCm    Float?   @map("waist_cm")
  hipCm      Float?   @map("hip_cm")
  armCm      Float?   @map("arm_cm")
  thighCm    Float?   @map("thigh_cm")
  chestCm    Float?   @map("chest_cm")
  bodyFatPct Float?   @map("body_fat_pct")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, measuredAt])
  @@map("body_measurements")
}
